--
--
--

with "config/heidelberger_config.gpr";
with "components-sqlite.gpr";

project Heidelberger is

   for Source_Dirs use (
      "source/",
      "source/include/",
      "source/include/block-support/",
      "source/include/customize/",
      "source/include/pomo/",
      "source/include/requests/",
      "source/include/style/",
      "source/admin/",
      "source/admin/include/",
      "source/bind/",
      "config/");
   for Object_Dir use "obj/" & Heidelberger_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("heidelberger.adb");

   package Compiler is

      for Local_Configuration_Pragmas
        use "source/heidelberger.adc";

      for Default_Switches ("Ada") use
         Heidelberger_Config.Ada_Compiler_Switches & (
         "-gnat2022",
         "-g",
         "-O0",
         "-Og",
         "-gnata",
         "-gnatwaCJ",
         "-gnatef",
         "-gnatf",
         "-gnatyyduxCM0S"); -- 0-r
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Heidelberger;
